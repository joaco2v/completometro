# Copia este archivo como .env para cambiar la configuración.
# Si no existe .env, la app funciona 100 % local (modo "local").

# Modo de operación: local | remoto
VITE_MODO=local

# URL del backend (solo se usa en modo remoto). Ver docs/BACKEND.md
VITE_BACKEND_URL=

# ID de cliente OAuth de Google para el respaldo automático en Drive. Ver docs/GOOGLE_DRIVE.md
# Sin este valor, la opción de Google Drive no aparece.
VITE_GOOGLE_CLIENT_ID=
